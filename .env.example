# Slack Incoming Webhook URL for alerts (Slack -> Apps -> Incoming Webhooks).
# Use a dedicated webhook for infra alerts, separate from any app's own logging.
SLACK_WEBHOOK_URL=

# Your home network CIDR. Any successful SSH login from outside this range
# triggers an immediate alert.
LAN_CIDR=192.168.1.0/24

# Cron schedules (5-field crontab syntax).
VULN_SCAN_CRON=0 4 * * *
ANOMALY_SCAN_CRON=*/5 * * * *

# Dashboard (http://<server-lan-ip>:3099) HTTP Basic Auth. The dashboard
# container refuses to start if DASHBOARD_PASSWORD is unset.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Absolute base URL of the dashboard above - used to build "View & fix"
# links in Slack alerts (relative paths don't work in a Slack message).
DASHBOARD_BASE_URL=http://192.168.1.4:3099

# "Fix with Claude" routines - one per fsScanProjects entry (src/config.js).
# Each pair is optional; a project only gets a "Fix with Claude" button once
# both its id and token are set. Set up at claude.ai/code/routines (one
# routine per project, API trigger) - see the routine setup steps in the
# home-sentinel plan/README. The token is a system credential (write access
# to that repo via an automated session) - generate and paste it directly
# into this file over your own SSH session, never through an assistant.
FIX_ROUTINE_API_COLLECTERLY_COM_ID=
FIX_ROUTINE_API_COLLECTERLY_COM_TOKEN=
FIX_ROUTINE_WWW_COLLECTERLY_COM_ID=
FIX_ROUTINE_WWW_COLLECTERLY_COM_TOKEN=
FIX_ROUTINE_FUEL_WEB_ID=
FIX_ROUTINE_FUEL_WEB_TOKEN=
FIX_ROUTINE_FUEL_ADMIN_ID=
FIX_ROUTINE_FUEL_ADMIN_TOKEN=
FIX_ROUTINE_FUEL_API_ID=
FIX_ROUTINE_FUEL_API_TOKEN=
FIX_ROUTINE_UNLEASH_ID=
FIX_ROUTINE_UNLEASH_TOKEN=
FIX_ROUTINE_SIMPLE_PROXY_ID=
FIX_ROUTINE_SIMPLE_PROXY_TOKEN=
FIX_ROUTINE_WWW_BURNY_UK_ID=
FIX_ROUTINE_WWW_BURNY_UK_TOKEN=
# joplin-server has no git repo on disk - no fix routine is possible for it.
