# Slack Incoming Webhook URL for alerts (Slack -> Apps -> Incoming Webhooks).
# Use a dedicated webhook for infra alerts, separate from any app's own logging.
SLACK_WEBHOOK_URL=

# Your home network CIDR. Any successful SSH login from outside this range
# triggers an immediate alert.
LAN_CIDR=192.168.1.0/24

# Cron schedules (5-field crontab syntax).
VULN_SCAN_CRON=0 4 * * *
ANOMALY_SCAN_CRON=*/5 * * * *

# Dashboard (http://<server-lan-ip>:3099) HTTP Basic Auth. The dashboard
# container refuses to start if DASHBOARD_PASSWORD is unset.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
